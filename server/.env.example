# Server
PORT=5001

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/syncspace

# Set to "true" if your Postgres host requires SSL (e.g. Render, Supabase, Neon)
DB_SSL=false

# JWT — use a long random string in production
JWT_SECRET=change_me_to_a_long_random_secret

# Google OAuth — from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here

# CORS — comma-separated allowed frontend origins (optional)
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174
